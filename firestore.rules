rules_version = '2';

// 킬렐러 우체국 — Firestore 보안 규칙
// Firebase 콘솔 > Firestore Database > 규칙(Rules) 탭에 이 파일 내용을 그대로 붙여 넣고 [게시]를 누르세요.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 함수 ----------
    function signedIn() {
      return request.auth != null;
    }
    function memberDoc() {
      return /databases/$(database)/documents/members/$(request.auth.uid);
    }
    function isMember() {
      return signedIn() && exists(memberDoc());
    }
    function isAdmin() {
      return isMember() && get(memberDoc()).data.role == 'admin';
    }
    function ownsChar(charId) {
      return get(/databases/$(database)/documents/characters/$(charId)).data.ownerUid == request.auth.uid;
    }
    function textOk(t, max) {
      return t is string && t.size() > 0 && t.size() <= max;
    }
    function optText(t, max) {
      return t is string && t.size() <= max;
    }

    // ---------- 초대 코드 (아무도 읽을 수 없음, 콘솔에서만 설정) ----------
    match /config/{doc} {
      allow read, write: if false;
    }

    // ---------- 비밀번호 초기화 결과 (GitHub Actions가 쓰고, 관리자만 읽고 지움) ----------
    match /resets/{uid} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    // ---------- 회원 ----------
    // 초대 코드가 맞아야 가입 문서를 만들 수 있습니다. 역할(role)은 콘솔에서만 'admin'으로 바꿀 수 있습니다.
    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['inviteCode', 'role', 'createdAt'])
        && request.resource.data.role == 'member'
        && request.resource.data.inviteCode == get(/databases/$(database)/documents/config/invite).data.code;
      allow update, delete: if false;
    }

    // ---------- 캐릭터 프로필 ----------
    match /characters/{charId} {
      allow read: if isMember();
      // NPC(자동으로 말하는 인물)는 GitHub Actions의 관리자 키로만 만들어집니다.
      allow create: if isMember()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.get('npc', false) == false
        && textOk(request.resource.data.name, 40)
        && optText(request.resource.data.bio, 4000)
        && optText(request.resource.data.avatar, 200000);
      allow update: if isMember()
        && (resource.data.ownerUid == request.auth.uid || isAdmin())
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.get('npc', false) == false
        && textOk(request.resource.data.name, 40)
        && optText(request.resource.data.bio, 4000)
        && optText(request.resource.data.avatar, 200000);
      allow delete: if isMember() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // ---------- 채팅 채널 ----------
    match /channels/{channelId}/messages/{msgId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid
        && ownsChar(request.resource.data.charId)
        && textOk(request.resource.data.text, 2000)
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isMember() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---------- 게시판 ----------
    match /posts/{postId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid
        && ownsChar(request.resource.data.charId)
        && textOk(request.resource.data.title, 120)
        && textOk(request.resource.data.body, 10000)
        && request.resource.data.commentCount == 0
        && request.resource.data.createdAt == request.time;
      // 작성자는 글을 고칠 수 있고, 회원은 댓글 수와 최근 활동 시각만 갱신할 수 있습니다.
      allow update: if isMember() && (
        (resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'editedAt'])
          && textOk(request.resource.data.title, 120)
          && textOk(request.resource.data.body, 10000))
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'lastActivityAt'])
          && (request.resource.data.commentCount == resource.data.commentCount + 1
              || request.resource.data.commentCount == resource.data.commentCount - 1))
      );
      allow delete: if isMember() && (resource.data.uid == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.uid == request.auth.uid
          && ownsChar(request.resource.data.charId)
          && textOk(request.resource.data.text, 3000)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isMember() && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }

    // ---------- 둘만의 방 (두 인물만 들어가는 장소형 채팅방) ----------
    function charDoc(id) {
      return get(/databases/$(database)/documents/characters/$(id)).data;
    }
    match /rooms/{roomId} {
      allow read: if isMember() && request.auth.uid in resource.data.participants;
      allow create: if isMember()
        && request.resource.data.participants is list && request.resource.data.participants.size() == 2
        && request.resource.data.chars is list && request.resource.data.chars.size() == 2
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.participants[0] == request.auth.uid
        && ownsChar(request.resource.data.chars[0])
        && charDoc(request.resource.data.chars[1]).ownerUid == request.resource.data.participants[1]
        && charDoc(request.resource.data.chars[1]).get('npc', false) == false
        && textOk(request.resource.data.place, 60)
        && optText(request.resource.data.note, 500)
        && request.resource.data.closed == false;
      allow update: if isMember()
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText', 'lastAt', 'lastSender', 'readAt', 'closed']);
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isMember()
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.participants;
        allow create: if isMember()
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.participants
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.closed == false
          && request.resource.data.uid == request.auth.uid
          && ownsChar(request.resource.data.charId)
          && textOk(request.resource.data.text, 2000)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isMember() && resource.data.uid == request.auth.uid;
      }
    }

    // ---------- 쪽지 (대화 당사자 두 사람만 읽고 쓸 수 있음) ----------
    match /dms/{convId} {
      allow read: if isMember() && request.auth.uid in resource.data.participants;
      allow create: if isMember()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow update: if isMember()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.chars == resource.data.chars;
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isMember()
          && request.auth.uid in get(/databases/$(database)/documents/dms/$(convId)).data.participants;
        // getAfter: 첫 쪽지는 대화방 문서와 함께 한 번에 만들어지므로, 쓰기 이후 상태를 확인합니다.
        allow create: if isMember()
          && request.auth.uid in getAfter(/databases/$(database)/documents/dms/$(convId)).data.participants
          && request.resource.data.uid == request.auth.uid
          && ownsChar(request.resource.data.charId)
          && textOk(request.resource.data.text, 3000)
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // 푸시 알림 주소: 각자 자기 문서만 쓰고 지울 수 있고, 아무도 읽을 수 없음 (알림 중계소만 관리자 키로 읽음)
    match /pushTokens/{userId} {
      allow read: if false;
      allow create, update, delete: if isMember() && request.auth.uid == userId;
    }
  }
}
